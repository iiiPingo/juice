#include <windows.h>
1 ICON "juice.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "juice.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Juice - battery levels for your wireless devices"
      VALUE "ProductName", "Juice"
      VALUE "FileVersion", "1.2.0"
      VALUE "ProductVersion", "1.2.0"
      VALUE "OriginalFilename", "Juice.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
